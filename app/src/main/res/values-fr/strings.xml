    <string name="app_name">Padland</string>

    <string name="title_activity_intro">Introduction</string>
    <string name="launch_intro">Lancer les écrans d\'introduction</string>
    <string name="intro_first_title">Bienvenue sur Padland!</string>
    <string name="intro_first_desc">Padland vous permet de lire, éditer, organiser et partager des documents collaboratifs.\n
 Cliquez sur la flèche pour voir comment ça marche !</string>
    <string name="intro_second_title">Créer des nouveaux documents</string>
    <string name="intro_second_desc">Créez des documents sur vos serveurs favoris. Vous pouvez ensuite les organiser par groupe et dire à vos amis de les rejoindre!</string>
    <string name="intro_third_title">Éditer des documents existants</string>
    <string name="intro_third_desc">Partager l\'URL d\'un document vers Padland pour l\'ouvrir et l\'éditer.</string>
    <string name="intro_fourth_title">Serveur personnalisé?</string>
    <string name="intro_fourth_desc">Pas de problème ! Vous pouvez ajouter vos serveurs favoris. Veuillez consulter pour cela les réglages, avec plein d\'autres options!</string>
    <string name="intro_fifth_title">C\'est parti !</string>
    <string name="intro_fifth_desc">Demandez de nouvelles fonctionnalités ou signalez des bugs sur le dépôt github.\n
              <a href="https://github.com/mikifus/padland">https://github.com/mikifus/padland</a> \n
 \n
 Cliquez sur OK pour commencer!</string>

